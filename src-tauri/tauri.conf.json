{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gify",
  "version": "0.1.0",
  "identifier": "com.hazoro.gify",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "skipTaskbar":true,
        "width": 300,
        "height": 500,
        "decorations":false,
        "alwaysOnTop":true,
        "visible":false,
        "resizable":false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
  "targets": "all"  
  }
}
